# Environment variables read by the service and the image generator. Copy to .env (ignored by
# git), fill in what you need and export it before running. Empty means unset.

# WhatsApp Cloud API
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# Optional LLM second layer (uv sync --extra llm)
ANTHROPIC_API_KEY=

# Path of a TOML settings file (see config.example.toml); empty uses the built-in defaults
ATTENDANT_CONFIG=

# Chromium-based browser for vitrine/src/build.py; empty looks for chromium, chrome or msedge
CHROME_PATH=
